{
  "name": "@mcp-devbridge/regular-chat-controller",
  "version": "0.0.1",
  "private": true,
  "description": "Provider-neutral durable browser chat controller for MCP DevBridge",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build && node ./scripts/run-tests.mjs unit",
    "test:fixture": "npm run build && node ./scripts/run-tests.mjs fixture",
    "test": "npm run test:unit && npm run test:fixture"
  },
  "dependencies": {
    "@bybrave/proper-lockfile2": "5.0.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2"
  }
}
